---
import type { InformationSession } from "@content";
import { Icon } from "astro-icon/components";
import { langFromUrl } from "@i18n/lang";
import { useTranslations } from "@i18n/ui";
import { formatMonthDay } from "@i18n/format";

interface Props {
  session: InformationSession;
  direction?: "column" | "row" | undefined;
}

const { session } = Astro.props;
const lang = langFromUrl(Astro.url);
const t = useTranslations(lang);
---

<div class="session">
  <div class="day">
    {session.day ? formatMonthDay(session.day, lang) : t("bachelor.anytime")}
  </div>
  <div class="hour">
    <Icon name="material-symbols:av-timer-outline-rounded" class="icon" />
    {
      session.hour ? (
        <span>
          <span>{session.hour.begin}</span>
          <span class="time-separator">--</span>
          <span>{session.hour.end}</span>
        </span>
      ) : (
        t("bachelor.anytime")
      )
    }
  </div>
  <div>
    <Icon name="material-symbols:pin-drop-outline-rounded" class="icon" />
    {session.place.display}
  </div>
  {
    session.note ? (
      <div>
        <Icon name="material-symbols:chat-info-outline-rounded" class="icon" />
        <span class="note">{session.note}</span>
      </div>
    ) : null
  }
</div>

<style
  define:vars={{
    direction: Astro.props.direction === "row" ? "row" : "column",
  }}
>
  .note {
    color: var(--color-text-weak);
  }

  .icon {
    color: var(--color-primary);
  }

  .day {
    font-weight: bold;
    margin-bottom: 0.3rem;
  }

  .session {
    display: flex;
    flex-direction: var(--direction);
    row-gap: 0.5rem;
    column-gap: 3rem;
    padding-top: 0.5rem;
    padding-bottom: 0.5rem;
  }

  .time-separator {
    color: var(--color-text-weak);
  }
</style>
