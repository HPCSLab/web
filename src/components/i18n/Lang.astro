---
import { langFromUrl } from "@i18n/lang";

interface Props {
  /**
   * 現在の言語のスロットが無いときに日本語へフォールバックするか。
   * 日本語版にしか意味のない内容 (国内向けの内線番号表記など) は
   * `fallback={false}` を指定して英語版では何も出さない。
   */
  fallback?: boolean | undefined;
}

/**
 * 日本語と英語を同じファイルに並べて書くためのディレクティブ。
 *
 * ```astro
 * <Lang>
 *   <Fragment slot="ja">日本語の本文</Fragment>
 *   <Fragment slot="en">English text</Fragment>
 * </Lang>
 * ```
 *
 * `en` スロットが無ければ日本語にフォールバックする (未翻訳の扱い)。
 * MDX の本文中でもそのまま使える。
 */
const { fallback = true } = Astro.props;
const lang = langFromUrl(Astro.url);
const hasEnglish = Astro.slots.has("en");

// `<slot name>` は静的な文字列でなければならないので、言語ごとに分けて書く
const showEnglish = lang === "en" && hasEnglish;
const showJapanese = lang === "ja" || (!hasEnglish && fallback);
---

{showEnglish ? <slot name="en" /> : null}
{showJapanese ? <slot name="ja" /> : null}
