---
import Header from "./parts/header/index.astro";
import Footer from "./parts/Footer.astro";
import { SEO } from "astro-seo";
import { LANGS, DEFAULT_LANG, langFromUrl, switchLangPath } from "@i18n/lang";

export type Props = {
  title: string;
  description: string;
};
const { title, description } = Astro.props;

const lang = langFromUrl(Astro.url);

// 検索エンジンに日英が同一ページの別言語版であることを伝える
const siteOrigin = Astro.site?.href.replace(/\/$/, "") ?? "";
const alternates = [
  ...LANGS.map((alternate) => ({
    hreflang: alternate,
    href: `${siteOrigin}${switchLangPath(Astro.url, alternate)}`,
  })),
  {
    hreflang: "x-default",
    href: `${siteOrigin}${switchLangPath(Astro.url, DEFAULT_LANG)}`,
  },
];
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <SEO
      title={title}
      description={description}
      extend={{
        link: [
          { rel: "stylesheet", href: "/destyle.css" },
          { rel: "stylesheet", href: "/global.css" },
        ],
        meta: [
          { name: "generator", content: Astro.generator },
          { name: "viewport", content: "width=device-width, initial-scale=1" },
        ],
      }}
    />
    {
      alternates.map((alternate) => (
        <link
          rel="alternate"
          hreflang={alternate.hreflang}
          href={alternate.href}
        />
      ))
    }
  </head><body>
    <Header lang={lang} />
    <div id="contents-wrapper">
      <main>
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>

<style is:global>
  main {
    min-height: calc(100vh - var(--header-height) - var(--footer-height));
  }
</style>
