---
import ResponsiveWidth from "@components/layout/ResponsiveWidth.astro";
import TopLevelSection from "@components/composite/section/H1.astro";
import ListItem from "@components/display/list/item/Naked.astro";
import List from "@components/display/list/list.astro";
import Base from "@layouts/base/index.astro";
import PublicationHeading from "@components/pages/publications/PublicationHeading.astro";
import SubClass from "@components/pages/publications/SubClass.astro";
import { Icon } from "astro-icon/components";
import NoImageHeader from "@components/composite/header/NoImageHeader.astro";
import { getCollection } from "astro:content";
import H2 from "@components/composite/heading/h2.astro";
import { withLangs, langFromParam, localePath } from "@i18n/lang";
import { useTranslations } from "@i18n/ui";

const years = [
  ...new Set((await getCollection("publication")).map((pub) => pub.data.year)),
].sort((a, b) => a - b);

export async function getStaticPaths() {
  const publicationYears = [
    ...new Set(
      (await getCollection("publication")).map((pub) => pub.data.year),
    ),
  ];
  return withLangs(publicationYears.map((year) => ({ year: year.toString() })));
}

const lang = langFromParam(Astro.params.lang);
const t = useTranslations(lang);

const year = parseInt(Astro.params.year, 10);

const journal = await getCollection(
  "publication",
  (pub) => pub.data.class.class === "journal" && pub.data.year == year,
);

const international = {
  conference: await getCollection(
    "publication",
    (pub) =>
      pub.data.class.class === "international" &&
      pub.data.class.subclass === "conference" &&
      pub.data.year === year,
  ),
  poster: await getCollection(
    "publication",
    (pub) =>
      pub.data.class.class === "international" &&
      pub.data.class.subclass === "poster" &&
      pub.data.year === year,
  ),
};

const domestic = {
  conference: await getCollection(
    "publication",
    (pub) =>
      pub.data.class.class === "domestic" &&
      pub.data.class.subclass === "conference" &&
      pub.data.year === year,
  ),
  poster: await getCollection(
    "publication",
    (pub) =>
      pub.data.class.class === "domestic" &&
      pub.data.class.subclass === "poster" &&
      pub.data.year === year,
  ),
  workshop: await getCollection(
    "publication",
    (pub) =>
      pub.data.class.class === "domestic" &&
      pub.data.class.subclass === "workshop" &&
      pub.data.year === year,
  ),
  magazine: await getCollection(
    "publication",
    (pub) =>
      pub.data.class.class === "domestic" &&
      pub.data.class.subclass === "magazine" &&
      pub.data.year === year,
  ),
  misc: await getCollection(
    "publication",
    (pub) =>
      pub.data.class.class === "domestic" &&
      pub.data.class.subclass === "misc" &&
      pub.data.year === year,
  ),
};

const prevYear = years[years.indexOf(year) - 1];
const nextYear = years[years.indexOf(year) + 1];

const internationalPubNum = Object.values(international)
  .map((pubs) => pubs.length)
  .reduce((a, b) => a + b);
const domesticPubNum = Object.values(domestic)
  .map((pubs) => pubs.length)
  .reduce((a, b) => a + b);

const title =
  lang === "en"
    ? `Publications in ${Astro.params.year}`
    : `${Astro.params.year}年度の研究発表`;
const description =
  lang === "en"
    ? `Journal articles and conference presentations in ${Astro.params.year} (${journal.length} journal, ${internationalPubNum} international, ${domesticPubNum} domestic)`
    : `${Astro.params.year}の学会発表、ジャーナル投稿一覧 (ジャーナル${journal.length}件、国際会議${internationalPubNum}件、国内${domesticPubNum})`;
---

<Base title={title} description={description}>
  <NoImageHeader>
    <span class="supplemental-text-in-heading">{t("publications.of")}</span>
    <span class="year-in-heading">{Astro.params.year}</span>
  </NoImageHeader>
  <ResponsiveWidth>
    <nav class="year-nav">
      <div class="year-link-container">
        {
          prevYear && (
            <a
              class:list={["prev-year", "year-link"]}
              href={localePath(lang, `/publications/${prevYear}`)}
            >
              <Icon
                name="material-symbols:chevron-left-rounded"
                class="nav-icon"
              />
              {prevYear}
            </a>
          )
        }
      </div>
      <div class="year-link-container">
        {
          nextYear && (
            <a
              class:list={["next-year", "year-link"]}
              href={localePath(lang, `/publications/${nextYear}`)}
            >
              {nextYear}
              <Icon
                name="material-symbols:chevron-right-rounded"
                class="nav-icon"
              />
            </a>
          )
        }
      </div>
    </nav>
  </ResponsiveWidth>
  <TopLevelSection backgroundInverted={false}>
    <H2>{t("publications.journal")}</H2>
    <List ordered={false}>
      {
        journal.map((pub) => (
          <ListItem>
            <PublicationHeading pub={pub} />
          </ListItem>
        ))
      }
    </List>
  </TopLevelSection>
  <TopLevelSection backgroundInverted={false}>
    <H2>{t("publications.international")}</H2>
    <SubClass
      title={t("publications.mainConference")}
      publications={international.conference}
    />
    <SubClass
      title={t("publications.poster")}
      publications={international.poster}
    />
  </TopLevelSection>
  <TopLevelSection backgroundInverted={false}>
    <H2>{t("publications.domestic")}</H2>
    <SubClass
      title={t("publications.domesticConference")}
      publications={domestic.conference}
    />
    <SubClass title={t("publications.poster")} publications={domestic.poster} />
    <SubClass
      title={t("publications.workshop")}
      publications={domestic.workshop}
    />
    <SubClass
      title={t("publications.magazine")}
      publications={domestic.magazine}
    />
    <SubClass title={t("publications.misc")} publications={domestic.misc} />
  </TopLevelSection>
</Base>

<style>
  .supplemental-text-in-heading {
    font-size: var(--font-size-lg);
  }

  .year-in-heading {
    font-weight: bold;
    font-size: var(--font-size-2xl);
  }

  .year-nav {
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    padding-block-start: 1rem;
  }

  .year-link {
    display: flex;
    flex-direction: row;
    align-items: center;
  }

  .nav-icon {
    color: var(--color-primary);
    font-size: var(--font-size-xl);
    transition: transform 0.1s linear;
  }

  .year-link-container:hover .nav-icon {
    transform: scale(1.5);
  }
</style>
