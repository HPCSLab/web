---
import Base from "@layouts/base/index.astro";
import ResponsiveWidth from "@components/layout/ResponsiveWidth.astro";
import Codeblock from "@components/display/codeblock.astro";
import NoImgHeader from "@components/composite/header/NoImageHeader.astro";
import { getCollection, getEntry } from "astro:content";
import { withLangs, langFromParam, localized } from "@i18n/lang";
import { useTranslations } from "@i18n/ui";

export async function getStaticPaths() {
  const publications = await getCollection("publication");
  return withLangs(
    publications.map((pub) => {
      const [year, id] = pub.id.split("/");
      return { year: year!, id: id! };
    }),
  );
}

const { year, id } = Astro.params;
const lang = langFromParam(Astro.params.lang);
const t = useTranslations(lang);
const pub = (await getEntry("publication", `${year}/${id}`))!.data;

const title = localized(lang, pub.title, pub.title_en);
const reference = localized(lang, pub.reference, pub.reference_en);
const booktitle = localized(lang, pub.booktitle, pub.booktitle_en);
---

<Base title={title} description={reference}>
  <article>
    <NoImgHeader>
      {title}
    </NoImgHeader>
    <ResponsiveWidth>
      <section class="description">
        <div class="reference">
          {reference}
        </div>

        <ul class="authors">
          {pub.authors.map((author) => <li class="author">{author}</li>)}
        </ul>

        <div class="booktitle">
          {booktitle}
        </div>
      </section>
      <section>
        <h2>{t("publications.bibtex")}</h2>
        <Codeblock code={pub.bibtex} />
      </section>
    </ResponsiveWidth>
  </article>
</Base>

<style>
  .header {
    background-color: var(--color-bg-dark);
  }
  h1 {
    color: var(--color-inverted-text-strong);
    font-weight: bold;
    font-size: var(--font-size-xl);
  }

  h2 {
    color: var(--color-text-strong);
    font-weight: bold;
    font-size: var(--font-size-lg);
    margin-bottom: 1rem;
  }

  .booktitle {
    font-size: var(--font-size-lg);
  }

  .description {
    margin-block-start: 1rem;
    margin-block-end: 1rem;
  }

  .authors {
    margin-block-end: 1rem;
    display: inline;
  }

  .author {
    margin-right: 1rem;
    display: inline;
  }

  .reference {
    font-family: var(--font-family-monospace);
    color: var(--color-text-weak);
    font-size: var(--font-size-sm);
    margin-block-end: 1rem;
  }

  .bibtex {
    display: block;
    background-color: var(--color-bg-dark);
    color: var(--color-inverted-text-normal);
    padding: 1rem;
    border-radius: 0.2rem;
    overflow-x: scroll;
    width: fit-content;
    height: fit-content;
  }
</style>
