---
import BlurImageHeader from "@components/composite/header/BlurImageHeader.astro";
import Base from "@layouts/base/index.astro";
import HpcsAll from "@asset/hpcs-all-2025.jpg";
import Typography from "@components/display/Typography.astro";
import H1Section from "@components/composite/section/H1.astro";
import Keyword from "@components/display/Keyword.astro";
import Chevron from "@components/display/list/item/Chevron.astro";
import List from "@components/display/list/list.astro";
import TeamCard from "@components/pages/bachelor/TeamCard.astro";
import Teams from "@components/pages/bachelor/Teams.astro";
import { getCollection } from "astro:content";
import H2 from "@components/composite/heading/h2.astro";
import Session from "@components/pages/bachelor/Session.astro";
import type { InformationSession } from "@content";
import { bachelorPageEnable } from "src/site.config";
import Lang from "@components/i18n/Lang.astro";
import { langPaths, langFromParam, localePath, pick } from "@i18n/lang";
import { useTranslations } from "@i18n/ui";

export const getStaticPaths = langPaths;

if (!bachelorPageEnable) {
  // eslint-disable-next-line no-undef
  return new Response(null, { status: 404 });
}

const lang = langFromParam(Astro.params.lang);
const t = useTranslations(lang);

const teams = await getCollection("team");
const generalSession: InformationSession = {
  place: {
    display: pick(lang, {
      ja: "CCS(計算科学研究センター) ワークショップ室",
      en: "Workshop Room, Center for Computational Sciences (CCS)",
    }),
    canonical: "筑波大学 計算科学研究センター ワークショップ室",
  },
  day: new Date("2025-10-7"),
  hour: {
    begin: "18:15",
    end: "19:45",
  },
};
---

<Base title={t("bachelor.title")} description={t("bachelor.description")}>
  <BlurImageHeader
    imgSrc={HpcsAll}
    imgAlt={pick(lang, {
      ja: "HPCS全員の集合写真",
      en: "Group photo of the whole HPCS Laboratory",
    })}
  >
    {t("bachelor.title")}
  </BlurImageHeader>
  <H1Section>
    <H2>{t("bachelor.lab")}</H2>
    <Lang>
      <Fragment slot="ja">
        <Typography>
          筑波大学 High Performance Computing System (HPCS) 研究室では,
          超並列計算機システムからコモディティクラスタシステムまで, 高性能計算
          (High Performance Computing) に関連する様々な研究を行っています．
        </Typography>
        <List ordered={false}>
          <Chevron>
            各種並列処理システムにおける<Keyword>高性能計算</Keyword>と性能評価
          </Chevron>
          <Chevron>
            プロセッサからネットワークまで<Keyword>
              計算機アーキテクチャ
            </Keyword>に関する研究
          </Chevron>
          <Chevron>
            <Keyword>GPU</Keyword>や<Keyword>メニーコア</Keyword>,<Keyword>
              FPGA
            </Keyword>などの高性能計算向けアーキテクチャの研究
          </Chevron>
          <Chevron>高性能並列処理<Keyword>コンパイラ</Keyword>の研究</Chevron>
          <Chevron>
            <Keyword>大規模データ処理</Keyword> (ビッグデータ) 技術の研究
          </Chevron>
          <Chevron>
            大規模計算機を支える<Keyword>ストレージ</Keyword>技術や<Keyword>
              システムソフトウェア
            </Keyword>に関する研究
          </Chevron>
          <Chevron>
            大規模計算機における<Keyword>高性能数値計算</Keyword>技術の研究
          </Chevron>
        </List>
        <Typography>
          特に,筑波大学計算科学研究センターで運用されている
          Pegasusや,東京大学と共同で運用されている Miyabi
          では,これらの大規模並列計算機を用いて各種計算科学応用分野と積極的な関係・共同研究を行っており,
          並列言語・ライブラリ・アルゴリズム等、様々な面で実世界に役立つ高性能計算の研究を進めています．
          研究室にある大規模 PC クラスタの他,ABCI や TSUBAME
          など他機構のスパコンも利用しながら研究を行っています．
        </Typography>
      </Fragment>
      <Fragment slot="en">
        <Typography>
          The High Performance Computing System (HPCS) Laboratory at the
          University of Tsukuba carries out a wide range of research related to
          High Performance Computing, covering everything from massively
          parallel supercomputers to commodity cluster systems.
        </Typography>
        <List ordered={false}>
          <Chevron>
            <Keyword>High performance computing</Keyword> and performance evaluation
            on a variety of parallel processing systems
          </Chevron>
          <Chevron>
            <Keyword>Computer architecture</Keyword>, from processors through to
            interconnection networks
          </Chevron>
          <Chevron>
            Architectures for high performance computing such as <Keyword>
              GPUs
            </Keyword>, <Keyword>many-core processors</Keyword> and <Keyword>
              FPGAs
            </Keyword>
          </Chevron>
          <Chevron>
            High performance parallel <Keyword>compilers</Keyword>
          </Chevron>
          <Chevron>
            <Keyword>Large-scale data processing</Keyword> (big data) technologies
          </Chevron>
          <Chevron>
            <Keyword>Storage</Keyword> technologies and <Keyword>
              system software
            </Keyword> that underpin large-scale computer systems
          </Chevron>
          <Chevron>
            <Keyword>High performance numerical computation</Keyword> on large-scale
            computer systems
          </Chevron>
        </List>
        <Typography>
          In particular, we make active use of Pegasus, operated by the Center
          for Computational Sciences at the University of Tsukuba, and Miyabi,
          operated jointly with the University of Tokyo. Using these large-scale
          parallel systems we collaborate closely with a wide range of
          computational science application fields, and pursue high performance
          computing that is useful in the real world through parallel languages,
          libraries, algorithms and much more. Alongside the large PC cluster in
          our own laboratory, we also make use of supercomputers at other
          institutions such as ABCI and TSUBAME.
        </Typography>
      </Fragment>
    </Lang>
  </H1Section>
  <H1Section>
    <H2>{t("bachelor.generalSession")}</H2>
    {
      generalSession ? (
        <Session session={generalSession} direction="row" />
      ) : (
        <b>{t("bachelor.tbd")}</b>
      )
    }
    <Lang>
      <Fragment slot="ja">
        <Typography>
          全体説明会は HPCS
          研究室に所属する先生が原則全員参加し，各チームの研究内容について紹介する説明会です．
          参加に当たって申し込みなどは必要ありません．直接，開催場所にお越し下さい！
        </Typography>
      </Fragment>
      <Fragment slot="en">
        <Typography>
          At the general information session, in principle every faculty member
          of the HPCS Laboratory takes part and introduces the research of each
          team. No registration is required — just come along to the venue!
        </Typography>
      </Fragment>
    </Lang>
    <H2>{t("bachelor.teamSession")}</H2>
    <Lang>
      <Fragment slot="ja">
        <Typography>
          各チームの説明会日程は下に記載されています．
          それぞれのチームについて詳細な説明が行われます.
          申し込みなどは必要ありません．直接，開催場所にお越し下さい！
        </Typography>
      </Fragment>
      <Fragment slot="en">
        <Typography>
          The schedule for each team's information session is listed below,
          where each team explains its research in more detail. No registration
          is required — just come along to the venue!
        </Typography>
      </Fragment>
    </Lang>
  </H1Section>
  <H1Section backgroundInverted={true} fullW={true}>
    <H2 backgroundInverted={true} slot="heading">{t("bachelor.teamList")}</H2>
    <Teams>
      {
        teams.map((team) => (
          <TeamCard
            team={team.data}
            href={localePath(lang, `/teams/${team.id}`)}
          />
        ))
      }
    </Teams>
  </H1Section>
  <H1Section>
    <H2>{t("bachelor.careers")}</H2>
    <div class="after-graduate">
      <div class="year">2025</div>
      <div>Preferred Networks</div>
      <div class="year">2024</div>
      <div>
        <Lang>
          <Fragment slot="ja">
            DataDirect Networks Japan,東京エレクトロン
          </Fragment>
          <Fragment slot="en">
            DataDirect Networks Japan, Tokyo Electron
          </Fragment>
        </Lang>
      </div>
      <div class="year">2019</div>
      <div>
        <Lang>
          <Fragment slot="ja">
            LINE,Treasure Data,FreakOut,Cadence Design Systems,
            Inc.,エリクソン・ジャパン
          </Fragment>
          <Fragment slot="en">
            LINE, Treasure Data, FreakOut, Cadence Design Systems, Inc.,
            Ericsson Japan
          </Fragment>
        </Lang>
      </div>
      <div class="year">2018</div>
      <div>
        <Lang>
          <Fragment slot="ja">
            筑波大学 計算科学研究センター,NTT 研究所,ヤフー,富士通,楽天,Fixstars
          </Fragment>
          <Fragment slot="en">
            Center for Computational Sciences (University of Tsukuba), NTT
            Laboratories, Yahoo! Japan, Fujitsu, Rakuten, Fixstars
          </Fragment>
        </Lang>
      </div>
      <div class="year">2017</div>
      <div>
        <Lang>
          <Fragment slot="ja">
            日立研究所,ヤフー,ドワンゴ,サイプレスセミコンダクタ
          </Fragment>
          <Fragment slot="en">
            Hitachi Research Laboratory, Yahoo! Japan, Dwango, Cypress
            Semiconductor
          </Fragment>
        </Lang>
      </div>
      <div class="year">
        {pick(lang, { ja: "2016以前", en: "2016 and earlier" })}
      </div>
      <div>
        <Lang>
          <Fragment slot="ja">
            筑波大学 計算科学研究センター,理化学研究所
            計算科学研究センター,富士通研究所,NTT 研究所,Google
            dublin,ヤフー,CyberAgent,Fixstars,リクルート,日立製作所,NTTデータ,パナソニック,株式会社ユーザーローカル,三菱スペース・ソフトウエア株式会社
          </Fragment>
          <Fragment slot="en">
            Center for Computational Sciences (University of Tsukuba), RIKEN
            Center for Computational Science, Fujitsu Laboratories, NTT
            Laboratories, Google Dublin, Yahoo! Japan, CyberAgent, Fixstars,
            Recruit, Hitachi, NTT Data, Panasonic, User Local, Mitsubishi Space
            Software
          </Fragment>
        </Lang>
      </div>
    </div>
    <h3 class="normal-h3-heading">{t("bachelor.internship")}</h3>
    <div class="after-graduate">
      <div class="year">2019</div>
      <div>
        <Lang>
          <Fragment slot="ja">理化学研究所</Fragment>
          <Fragment slot="en">RIKEN</Fragment>
        </Lang>
      </div>
      <div class="year">2018</div>
      <div>
        <Lang>
          <Fragment slot="ja">
            理化学研究所,NTT 研究所,サイボウズラボ,Treasure
            Data,PFN,メルカリ,LINE,Fixstars,ヤフー
          </Fragment>
          <Fragment slot="en">
            RIKEN, NTT Laboratories, Cybozu Labs, Treasure Data, Preferred
            Networks, Mercari, LINE, Fixstars, Yahoo! Japan
          </Fragment>
        </Lang>
      </div>
      <div class="year">2017</div>
      <div>
        <Lang>
          <Fragment slot="ja">ヤフー,Fixstars</Fragment>
          <Fragment slot="en">Yahoo! Japan, Fixstars</Fragment>
        </Lang>
      </div>
      <div class="year">
        {pick(lang, { ja: "2016以前", en: "2016 and earlier" })}
      </div>
      <div>
        <Lang>
          <Fragment slot="ja">
            Argonne National
            Laboratory,日立製作所中央研究所,ノーチラステクノロジーズ,Fixstars
          </Fragment>
          <Fragment slot="en">
            Argonne National Laboratory, Hitachi Central Research Laboratory,
            Nautilus Technologies, Fixstars
          </Fragment>
        </Lang>
      </div>
    </div>
  </H1Section>
</Base>

<style>
  .normal-h3-heading {
    font-size: var(--font-size-lg);
    font-weight: bold;
  }

  .general-session-link {
    background-color: var(--color-primary);
    width: fit-content;
    padding: 0.7rem;
    font-weight: bolder;
    color: var(--color-inverted-text-strong);
    border-radius: 0.5rem;
    box-shadow: 0px 10px 10px -6px rgba(0, 0, 0, 0.3);
    transition: box-shadow 0.1s linear;
  }

  .general-session-link:hover {
    box-shadow: 0px 10px 10px -6px rgba(0, 0, 0, 0.6);
  }

  .after-graduate {
    margin-block-start: 1rem;
    margin-block-end: 2rem;
    display: grid;
    grid-template-columns: max-content 1fr;
    row-gap: 1.5rem;
    column-gap: 0.75rem;
  }

  .year {
    text-align: right;
    color: var(--color-text-weak);
  }
</style>
