---
import NoImageHeader from "@components/composite/header/NoImageHeader.astro";
import H1Section from "@components/composite/section/H1.astro";
import ChevronListItem from "@components/display/list/item/Chevron.astro";
import List from "@components/display/list/list.astro";
import AlumniCard from "@components/pages/members/Alumni.astro";
import Base from "@layouts/base/index.astro";
import { getCollection } from "astro:content";
import {
  isFacultyAlumnus,
  isNotFacultyAlumnus,
  type CollectionDataEntry,
  type Alumnus,
  type NotFacultyAlumnus,
} from "@content";
import H2 from "@components/composite/heading/h2.astro";
import { langPaths, langFromParam } from "@i18n/lang";
import { useTranslations } from "@i18n/ui";

export const getStaticPaths = langPaths;

const lang = langFromParam(Astro.params.lang);
const t = useTranslations(lang);

const facultyAlumni = (await getCollection("alumni")).filter(isFacultyAlumnus);
const alumni = (
  (await getCollection("alumni")) as CollectionDataEntry<Alumnus>[]
).filter(isNotFacultyAlumnus);

/** 卒業年月の古い順、同月なら名前順に並べる */
function byGraduation(a: NotFacultyAlumnus, b: NotFacultyAlumnus): number {
  const diff =
    new Date(a.year, a.month - 1).getTime() -
    new Date(b.year, b.month - 1).getTime();
  return diff === 0 ? a.name.localeCompare(b.name) : diff;
}

function alumniOf(type: NotFacultyAlumnus["type"]): NotFacultyAlumnus[] {
  return alumni
    .filter((alumnus) => alumnus.data.type === type)
    .map((alumnus) => alumnus.data)
    .sort(byGraduation);
}
---

<Base title={t("alumni.title")} description={t("alumni.description")}>
  <NoImageHeader>{t("alumni.heading")}</NoImageHeader>
  <H1Section backgroundInverted={false}>
    <H2>{t("alumni.faculty")}</H2>
    <List ordered={false}>
      {
        facultyAlumni.map((faculty) => (
          <ChevronListItem>{faculty.data.name}</ChevronListItem>
        ))
      }
    </List>
  </H1Section>
  <H1Section backgroundInverted={false}>
    <H2>{t("alumni.staff")}</H2>
    <AlumniCard alumni={alumniOf("staff")} />
  </H1Section>
  <H1Section backgroundInverted={false}>
    <H2>{t("alumni.doctor")}</H2>
    <AlumniCard alumni={alumniOf("doctor")} />
  </H1Section>
  <H1Section backgroundInverted={false}>
    <H2>{t("alumni.master")}</H2>
    <AlumniCard alumni={alumniOf("master")} />
  </H1Section>
  <H1Section backgroundInverted={false}>
    <H2>{t("alumni.bachelor")}</H2>
    <AlumniCard alumni={alumniOf("undergraduate")} />
  </H1Section>
</Base>
